# Cloudflare Pages リダイレクト設定
# フォーマット: <from> <to> <status>
# 参照: 仕様書 7.6, docs/redirects.csv (追加分ここに集約)

# 本番の canonical URL は apex (lyricstheory.com)。
# 過去10年のはてブ被リンク・SEO 資産がすべて apex URL で登録されているため（Phase 5 実データ調査で確定）。

# www → apex 正規化（DNS/Cloudflare Redirect Rules で先に処理される想定だが二重保険）
https://www.lyricstheory.com/* https://lyricstheory.com/:splat 301
http://www.lyricstheory.com/* https://lyricstheory.com/:splat 301

# WordPress 時代の /wordpress/ サブディレクトリ入り口へのアクセスは
# 現行 apex ルートにリダイレクト（画像パス /wordpress/wp-content/uploads/... は
# 実ファイル配置に一致するので明示的に例外）
/wordpress/  /  301
/wordpress/wp-content/uploads/*  /wordpress/wp-content/uploads/:splat  200
/wordpress/*  /:splat  301

# 旧 WordPress 内部生成 URL（管理系）は 404 で明示的に消す
/wp-admin/*  /  404
/wp-login.php  /  404
/xmlrpc.php  /  404

# 旧 WordPress プラグインが生成していた便宜 URL のうち、コンテンツ性がないもの
/register/  /  301
/login/  /  301

# elements のスラッグ改名（2026-07-26）
# 倒置の英訳を style_rules.md 規則14 の確定訳 retrograde に統一。
# inversion は十二音技法では音程反転（反行）を指し、正反対に読まれるため。
# 旧 URL は X に投稿済みのため 301 で保全する。
/elements/hajimete-no-koi-ga-owaru-toki-consonant-inversion/  /elements/hajimete-no-koi-ga-owaru-toki-consonant-retrograde/  301

# elements のスラッグ改名（2026-08-02 → 2026-08-09 に再改名）
# anagram-abca の abca は改訂前の形式ラベルで、当時の title（ABA' → A'AB）と対応していなかった。
# 本文が並べ替えと倒置の二案を保留したままだったので、いったん読みを断定する語を名前から外し、
# 対象の音を綴る形（dashita-tadashi）にした。
# 2026-08-09、清濁を類音としてまとめる判断で読みが倒置に確定したため、
# 規約どおり観察名を足して retrograde-dashita へ改名した。
# リダイレクトのチェーンを作らないよう、旧2世代とも新 slug へ直接向ける。
/elements/tadashii-machi-anagram-abca/  /elements/tadashii-machi-retrograde-dashita/  301
/elements/tadashii-machi-dashita-tadashi/  /elements/tadashii-machi-retrograde-dashita/  301

# aba は形式ラベルで、子音ピボットは分布の観察であってパターンではない
# （2026-08-02、やおき裁定。docs/theory-glossary.md「子音ピボット」）。
# 観察の中身（中央で母音が動く）を綴る形に改めた。
/elements/seishun-t-pivot-aba/  /elements/seishun-t-pivot-middle-vowel/  301

# WordPress 時代（2015〜2022）に稼働していた RSS フィードの正規 URL。
# Wayback Machine で /feed/ 自体が 200 を返していたことを確認済み。
# フィードリーダーに登録済みの購読者が残っている可能性があるため、URL を保ったまま
# 現行のフィード実装へ透過的に書き換える（リダイレクトではなく 200）。
/feed/  /feed/index.xml  200
