---
interface TocItem {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props as Props;
---

{
  items && items.length > 0 && (
    <nav aria-label="目次" class="my-8 rounded-md border border-gray-200 bg-gray-50 p-4 text-sm">
      <p class="mb-2 font-semibold">目次</p>
      <ul class="space-y-1">
        {items.map((item) => (
          <li class={item.depth === 3 ? 'ml-4' : ''}>
            <a href={`#${item.slug}`} class="text-blue-700 hover:underline">
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
