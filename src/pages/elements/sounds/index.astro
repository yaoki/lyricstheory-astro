---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  axesOf,
  buildQuery,
  CONSONANT_LABELS,
  CONSONANT_ORDER,
  VOWEL_LABELS,
  VOWEL_ORDER,
} from '../../../lib/phoneme/axis';
import { containsMoraSubsequence, extractLyricQuoteSegments } from '../../../lib/phoneme/lyric-mora';

// 音で引く入口。**新しい URL はこの 1 枚だけで、軸ごとの URL は切らない**（D6）。
// 絞り込みは /elements/ と同じくクライアント側でやる。切った瞬間に軸の綴りが
// SEO 資産になり、正規化ルールを直したときに 301 なしで動かせなくなる。
//
// **二段構え**（2026-08-15、A案）。国歌大観の五句索引（句という連なりをそのまま引く）に
// 対応するのは、軸への分解ではなく「連なりの段」のほうである。軸の段（旧・唯一のロジック）は
// 「音の類縁で広く見る」段として下に残す。詳細は docs/sound-lookup-plan.md。

const iso = (d: Date) => d.toISOString().slice(0, 10);

const entries = await getCollection('elements');

type Row = {
  id: string;
  title: string;
  tags: string[];
  consonants: string[];
  vowels: string[];
  song: string | null;
  repetition: string | undefined;
  type: string;
  updated: string;
  // 引用（<LyricQuote>）から取った、行ごとのモーラ列。連なりの段の元データ。
  // 引用を持たないカードは空配列（＝連なりの段の対象外、軸の段のみ）
  moraSegments: string[][];
};

const rows: Row[] = entries
  .map((entry) => {
    const tags = entry.data.tags?.phoneme ?? [];
    const { consonants, vowels } = axesOf(tags);
    return {
      id: entry.id,
      title: entry.data.title,
      tags,
      consonants,
      vowels,
      song: entry.data.song ? `${entry.data.song.artist}『${entry.data.song.title}』` : null,
      repetition: entry.data.tags?.repetition,
      type: entry.data.type,
      updated: iso(entry.data.updated),
      moraSegments: extractLyricQuoteSegments(entry.body ?? ''),
    };
  })
  // 音のタグを持たないカード（type: principle など）は音で引けない。
  // 一覧に出しても常に 0 件マッチなので、この入口には載せない
  .filter((row) => row.tags.length > 0)
  .sort((a, b) => b.updated.localeCompare(a.updated));

const countBy = (pick: (row: Row) => string[]) => {
  const out = new Map<string, number>();
  for (const row of rows) for (const key of pick(row)) out.set(key, (out.get(key) ?? 0) + 1);
  return out;
};

const consonantCounts = countBy((r) => r.consonants);
const vowelCounts = countBy((r) => r.vowels);

const consonantAxes = CONSONANT_ORDER.filter((k) => consonantCounts.has(k)).map((key) => ({
  key,
  label: CONSONANT_LABELS[key] ?? key,
  count: consonantCounts.get(key) ?? 0,
}));
const vowelAxes = VOWEL_ORDER.filter((k) => vowelCounts.has(k)).map((key) => ({
  key,
  label: VOWEL_LABELS[key] ?? key,
  count: vowelCounts.get(key) ?? 0,
}));

// 例に出す語は、実際に引いて何か返るものを選ぶ。空振りする例を置くと壊れて見える
// さらに、語そのものが引用に実在することも条件にする。旧 EXAMPLES の「りんご」「あかい」は
// 93枚の引用に一度も現れないのにヒットが返っていた（この装置は語の音で引くのであって
// 語そのものを探していないため）。それは「その語が歌詞にある」と誤読させる
// （docs/sound-lookup-plan.md「既知の欠陥」）
//
// 例語はいずれも**連なりの段で1枚以上当たる**（なみだ＝『涙がキラリ☆』の「おなじなみだが
// きらり」等）ことを確認済み。連なりの段が主なので、ここで空振りする語を置くと
// 新しい欠陥を同じ形で繰り返すことになる
const EXAMPLES = ['なみだ', 'ふたり', 'さよなら'];
// 件数は既定の閾値（軸=2 軸以上、連なり=完全一致 1 件以上）で数える。クライアント側と
// 揃えないと、例に書いてある数と実際に出る枚数が食い違う
const examples = EXAMPLES.map((word) => {
  const { mora, axes } = buildQuery(word);
  const axisHits = rows.filter(
    (row) =>
      axes.consonants.filter((c) => row.consonants.includes(c)).length +
        axes.vowels.filter((v) => row.vowels.includes(v)).length >=
      2,
  ).length;
  const sequenceHits = rows.filter((row) => containsMoraSubsequence(row.moraSegments, mora)).length;
  return { word, mora, axisHits, sequenceHits };
});
---

<BaseLayout
  title="音で引く | elements | lyricstheory.com"
  description="語や音を入れると、その音について書かれた観察カードが返る。子音軸・母音軸で elements を引くための入口。"
>
  <p class="mb-2 text-sm text-gray-500">
    <a href="/" class="hover:underline">lyricstheory.com</a> /
    <a href="/elements/" class="hover:underline">elements</a> / 音で引く
  </p>
  <h1 class="mb-4 text-2xl font-bold">音で引く</h1>
  <p class="mb-6 text-gray-700">
    語を入れると、まず<strong>その音の並びがそのまま現れる観察</strong>を、次に<strong>音の類縁（子音・母音）で広げた観察</strong>を返します。語そのものを探しているのではありません。返るのは<strong>先人が何をしたかの実例</strong>であって、
    韻を踏めるかどうかの判定ではありません。
  </p>

  <section class="mb-8 rounded border border-gray-200 p-4">
    <label for="q" class="mb-1 block text-sm font-semibold text-gray-700">語の音で引く</label>
    <input
      id="q"
      type="text"
      autocomplete="off"
      placeholder="なみだ"
      class="w-full rounded border border-gray-300 px-3 py-2 text-lg"
    />
    <p class="mt-2 text-xs text-gray-500">
      かなで入れてください。漢字は読みが割れる字があるので変換しません（「頬」など）。
    </p>
    <p class="mt-1 text-xs text-gray-400">
      例:
      {
        examples.map((ex, i) => (
          <>
            {i > 0 && ' / '}
            <button type="button" data-example={ex.word} class="text-blue-700 underline">
              {ex.word}
            </button>
            <span class="text-gray-300"> (連なり{ex.sequenceHits}・軸{ex.axisHits})</span>
          </>
        ))
      }
    </p>
    {/*
      **Tailwind の `hidden` クラスを使わない。**JS 側は `.hidden` プロパティ（属性）で
      出し入れするので、クラスで `display: none` を当てると属性を外しても消えたままになる
    */}
    <p class="mt-3 text-sm text-gray-600" hidden data-parse></p>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 text-lg font-semibold text-gray-800">この音の連なりがある観察</h2>
    <p class="mb-3 text-xs text-gray-500">
      入力した語の音の並びが、<strong>そのままの順序で</strong>引用に現れる観察です。国歌大観の索引が和歌の句をそのまま引けるようにしたのと同じで、ここは語を分解しません。清濁が違えば別の音として扱います。
    </p>
    <ul class="space-y-4" id="sequence-list">
      {
        rows
          .filter((row) => row.moraSegments.length > 0)
          .map((row) => (
            <li data-mora={JSON.stringify(row.moraSegments)} data-updated={row.updated} hidden>
              <a href={`/elements/${row.id}/`} class="text-base font-medium text-blue-700 underline">
                {row.title}
              </a>
              <p class="mt-0.5 text-xs text-amber-700" data-sequence-why />
            </li>
          ))
      }
    </ul>
    <p class="text-sm text-gray-500" data-sequence-hint>語を入れると、ここに観察が並びます。</p>
    <p class="text-sm text-gray-500" hidden data-sequence-empty>
      この音の並びを引用に持つ観察はまだありません。<strong>まだ書いていない</strong>という意味で、その音が使われていないという意味ではありません。
    </p>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 text-sm font-semibold text-gray-700">近い音の観察（軸の一致）</h2>
    <p class="mb-3 text-xs text-gray-500">
      ここは語を子音・母音の<strong>軸</strong>へ分解し、音の類縁で広く見る段です。押すと足し引きできます。<strong>子音軸で引くと、その子音を含むモーラのカードにも届きます</strong>——
      「タ行」で引けば <code>t</code> のカードだけでなく <code>ta</code>・<code>te</code> のカードも返ります。
      逆は返りません（<code>t</code> のカードは「ta を観察した」とは言っていないため）。
    </p>
    <div class="mb-3 flex flex-wrap gap-1.5 text-xs">
      {
        consonantAxes.map((axis) => (
          <button
            type="button"
            data-axis="c"
            data-key={axis.key}
            aria-pressed="false"
            class="rounded-full border border-gray-400 px-2.5 py-1 text-gray-700 aria-pressed:border-gray-800 aria-pressed:bg-gray-800 aria-pressed:text-white"
          >
            {axis.label} <span class="text-gray-400 aria-pressed:text-gray-300">{axis.count}</span>
          </button>
        ))
      }
    </div>
    <div class="flex flex-wrap gap-1.5 text-xs">
      {
        vowelAxes.map((axis) => (
          <button
            type="button"
            data-axis="v"
            data-key={axis.key}
            aria-pressed="false"
            class="rounded-full border border-emerald-500 px-2.5 py-1 text-emerald-800 aria-pressed:bg-emerald-700 aria-pressed:text-white"
          >
            {axis.label} <span class="text-emerald-500 aria-pressed:text-emerald-100">{axis.count}</span>
          </button>
        ))
      }
    </div>
  </section>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b pb-2 text-xs">
    <p class="text-gray-500" data-count>{rows.length} 枚</p>
    <div class="flex gap-2">
      <button
        type="button"
        data-loosen
        aria-pressed="false"
        hidden
        class="rounded border border-gray-300 px-2 py-1 text-gray-600 aria-pressed:border-gray-700 aria-pressed:text-gray-900"
      >
        1 軸だけの一致も見る
      </button>
      <button type="button" data-clear class="rounded border border-gray-300 px-2 py-1 text-gray-600">
        選択を消す
      </button>
    </div>
  </div>

  <ul class="space-y-5" id="sound-list">
    {
      rows.map((row) => (
        <li
          data-c={row.consonants.join(' ')}
          data-v={row.vowels.join(' ')}
          data-tags={row.tags.join(' ')}
          data-updated={row.updated}
        >
          <a href={`/elements/${row.id}/`} class="text-base font-medium text-blue-700 underline">
            {row.title}
          </a>
          <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500">
            <span>音素: {row.tags.join(', ')}</span>
            {row.repetition && <span class="text-gray-400">{row.repetition.toUpperCase()}反復</span>}
            <span class="text-gray-400">{row.type}</span>
          </div>
          <p class="mt-0.5 text-xs text-amber-700" hidden data-why />
        </li>
      ))
    }
  </ul>

  <section class="mt-16 border-t pt-6 text-sm text-gray-600">
    <p>
      ここに出るのは<strong>観察したと申告のあるカード</strong>だけです。ある音が歌詞に含まれていても、
      それについて書かれたカードが無ければ返りません。<strong>空振りは「その音が使われていない」ではなく
      「まだ書いていない」という意味</strong>で、次に何を分析するかの手がかりになります。
    </p>
    <p class="mt-2">
      <a href="/elements/" class="text-blue-700 underline">カード一覧へ戻る</a>
    </p>
  </section>
</BaseLayout>

<script>
  import { buildQuery, CONSONANT_LABELS, VOWEL_LABELS } from '../../../lib/phoneme/axis';
  import { containsMoraSubsequence } from '../../../lib/phoneme/lyric-mora';

  const list = document.getElementById('sound-list');
  const input = document.getElementById('q') as HTMLInputElement | null;

  // 連なりの段。軸の段（下の list）とは独立した要素・独立した表示ロジックを持つ。
  // KWIC 禁止（sound-lookup-plan.md「やらないこと」）——ここで出してよいのはタイトル・
  // リンクと「連なって現れます」の定型文だけで、一致位置や前後の文脈は一切出さない
  const sequenceList = document.getElementById('sequence-list');
  const sequenceItems = sequenceList ? (Array.from(sequenceList.children) as HTMLLIElement[]) : [];
  const sequenceHint = document.querySelector('[data-sequence-hint]') as HTMLElement | null;
  const sequenceEmpty = document.querySelector('[data-sequence-empty]') as HTMLElement | null;

  const renderSequence = (word: string, mora: string[]) => {
    const hasQuery = mora.length > 0;
    let visible = 0;
    for (const li of sequenceItems) {
      if (!hasQuery) {
        li.hidden = true;
        continue;
      }
      const segments = JSON.parse(li.dataset.mora ?? '[]') as string[][];
      const hit = containsMoraSubsequence(segments, mora);
      li.hidden = !hit;
      if (hit) {
        visible += 1;
        // 表示するのは「連なって現れる」という事実だけ。一致位置・前後の文字は出さない
        const why = li.querySelector('[data-sequence-why]') as HTMLElement | null;
        if (why) why.textContent = `引用に「${word}」が連なって現れます`;
      }
    }
    if (sequenceHint) sequenceHint.hidden = hasQuery;
    // 0 件は「その音が使われていない」ではなく「まだ書いていない」の意味
    if (sequenceEmpty) sequenceEmpty.hidden = !hasQuery || visible > 0;
  };

  if (list && input) {
    const items = Array.from(list.children) as HTMLLIElement[];
    const countLabel = document.querySelector('[data-count]');
    const parseLabel = document.querySelector('[data-parse]') as HTMLElement | null;
    const axisButtons = Array.from(
      document.querySelectorAll('[data-axis]'),
    ) as HTMLButtonElement[];

    // クエリは「軸の集合」で持つ。語を打つと集合が置き換わり、軸を押すと足し引きされる。
    // 語と軸を別々のモードにしないのは、ふたり と打ってから母音だけ外す、のような
    // 絞り方が自然に出るため
    const selected = { c: new Set<string>(), v: new Set<string>() };
    // 直接一致（カードのタグが、打った語のモーラそのもの）を強調するために持つ
    let queryMora: string[] = [];
    // 1 軸だけの一致まで出すか。既定は出さない——語は複数の軸に分かれるので、
    // どれか 1 つで当てると母音 a（34枚）のような太い軸が全部を拾い、絞り込みにならない。
    // 実測（92枚）で「りんご」は 1 軸込みで 50 枚、2 軸以上で 10 枚
    let loosen = false;
    const loosenButton = document.querySelector('[data-loosen]') as HTMLButtonElement | null;

    const render = () => {
      const hasQuery = selected.c.size > 0 || selected.v.size > 0;
      const axisCount = selected.c.size + selected.v.size;
      let visible = 0;

      const scored = items.map((li) => {
        const c = (li.dataset.c ?? '').split(' ').filter(Boolean);
        const v = (li.dataset.v ?? '').split(' ').filter(Boolean);
        const tags = (li.dataset.tags ?? '').split(' ').filter(Boolean);
        const hitC = c.filter((x) => selected.c.has(x));
        const hitV = v.filter((x) => selected.v.has(x));
        const direct = tags.filter((t) => queryMora.includes(t));
        return { li, score: hitC.length + hitV.length, hitC, hitV, direct };
      });

      // 軸が 2 つ以上あるクエリでは、2 軸以上当たったものだけを出す。
      // 1 軸しか無いクエリ（軸ボタンを 1 つ押しただけ）では当然 1 軸で出す
      const threshold = loosen || axisCount < 2 ? 1 : 2;
      const tiers = new Map<number, number>();
      for (const { score } of scored) {
        if (score > 0) tiers.set(score, (tiers.get(score) ?? 0) + 1);
      }

      // 一致した軸の数で並べ、同点なら更新順。**点は付けない**——順位は
      // 「いくつの軸で引っかかったか」という事実で、良し悪しの判定ではない
      scored
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          if (b.direct.length !== a.direct.length) return b.direct.length - a.direct.length;
          return (b.li.dataset.updated ?? '').localeCompare(a.li.dataset.updated ?? '');
        })
        .forEach(({ li, score, hitC, hitV, direct }) => {
          list.appendChild(li);
          const show = !hasQuery || score >= threshold;
          li.hidden = !show;
          if (show) visible += 1;

          const why = li.querySelector('[data-why]') as HTMLElement | null;
          if (!why) return;
          if (!hasQuery || score === 0) {
            why.hidden = true;
            return;
          }
          const parts = [
            ...hitC.map((x) => CONSONANT_LABELS[x] ?? x),
            ...hitV.map((x) => VOWEL_LABELS[x] ?? x),
          ];
          why.hidden = false;
          why.textContent =
            direct.length > 0
              ? `${parts.join('・')} で一致（${direct.join(', ')} は直接の申告）`
              : `${parts.join('・')} で一致`;
        });

      if (countLabel) {
        // 段ごとの内訳を出す。「50枚が該当」だけだと絞り込めていないことが見えない
        const breakdown = [...tiers.entries()]
          .sort((a, b) => b[0] - a[0])
          .map(([score, n]) => `${score}軸 ${n}枚`)
          .join(' / ');
        countLabel.textContent = !hasQuery
          ? `${items.length} 枚`
          : `${visible} 枚を表示中${breakdown ? `　（${breakdown}）` : ''}`;
      }
      if (loosenButton) {
        loosenButton.hidden = !hasQuery || axisCount < 2;
        loosenButton.setAttribute('aria-pressed', String(loosen));
      }
      axisButtons.forEach((btn) => {
        const kind = btn.dataset.axis as 'c' | 'v';
        btn.setAttribute('aria-pressed', String(selected[kind].has(btn.dataset.key ?? '')));
      });
    };

    const applyWord = (word: string) => {
      const { mora, axes } = buildQuery(word);
      queryMora = mora;
      selected.c = new Set(axes.consonants);
      selected.v = new Set(axes.vowels);
      if (parseLabel) {
        parseLabel.hidden = mora.length === 0;
        parseLabel.textContent =
          mora.length === 0
            ? ''
            : `${mora.join(' · ')} → 子音 ${axes.consonants.join('・') || 'なし'} / 母音 ${axes.vowels.join('・') || 'なし'}`;
      }
      renderSequence(word, mora);
      render();
    };

    input.addEventListener('input', () => applyWord(input.value));

    document.querySelectorAll('[data-example]').forEach((btn) => {
      btn.addEventListener('click', () => {
        input.value = (btn as HTMLElement).dataset.example ?? '';
        applyWord(input.value);
      });
    });

    axisButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.axis as 'c' | 'v';
        const key = btn.dataset.key ?? '';
        if (selected[kind].has(key)) selected[kind].delete(key);
        else selected[kind].add(key);
        // 軸を手で触った時点で、語との対応は崩れている。直接一致の強調を外す。
        // 連なりの段も「語」を前提にしているので、同じタイミングで未入力状態へ戻す
        queryMora = [];
        renderSequence('', []);
        render();
      });
    });

    loosenButton?.addEventListener('click', () => {
      loosen = !loosen;
      render();
    });

    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      selected.c.clear();
      selected.v.clear();
      queryMora = [];
      loosen = false;
      input.value = '';
      if (parseLabel) parseLabel.hidden = true;
      renderSequence('', []);
      render();
    });

    // `/elements/sounds/#なみだ` で語を、`#c=t` `#v=a` で軸を指定できる。
    // 軸ごとの URL を切っているのではなく、この 1 枚の中の状態を指しているだけ
    const hash = decodeURIComponent(location.hash.replace('#', ''));
    if (hash.startsWith('c=') || hash.startsWith('v=')) {
      const [kind, key] = hash.split('=') as ['c' | 'v', string];
      selected[kind].add(key);
      render();
    } else if (hash) {
      input.value = hash;
      applyWord(hash);
    } else {
      render();
    }
  }
</script>
