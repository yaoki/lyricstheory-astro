---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LyricQuote from '../../../components/LyricQuote.astro';
import Score from '../../../components/Score.astro';
import { splitLinks } from '../../../lib/linkify';

export async function getStaticPaths() {
  const entries = await getCollection('elements');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const MATURITY_LABELS: Record<string, string> = {
  seed: '種 (seed)',
  budding: '芽 (budding)',
  evergreen: '常緑 (evergreen)',
};

const REPETITION_LABELS: Record<string, string> = {
  c: 'C反復（子音のみが一致）',
  v: 'V反復（母音のみが一致）',
  cv: 'CV反復（子音と母音の両方が一致）',
};

const [elements, posts] = await Promise.all([getCollection('elements'), getCollection('blog')]);

interface RelatedLink {
  key: string;
  title: string;
  href: string;
  kind: 'element' | 'essay';
}

const relatedLinks: RelatedLink[] = (entry.data.related ?? [])
  .map((key: string): RelatedLink | null => {
    const el = elements.find((e) => e.id === key);
    if (el) {
      return { key, title: el.data.title, href: `/elements/${el.id}/`, kind: 'element' };
    }
    const post = posts.find((p) => p.data.slug === key);
    if (post) {
      return { key, title: post.data.title, href: `/${post.data.slug}/`, kind: 'essay' };
    }
    return null;
  })
  .filter((link): link is RelatedLink => link !== null);

const phoneme = entry.data.tags?.phoneme ?? [];
const repetition = entry.data.tags?.repetition;
const artist = entry.data.tags?.artist ?? [];
const era = entry.data.tags?.era;
const lang = entry.data.tags?.lang ?? 'ja';
const sources = entry.data.sources ?? [];
const maturityLabel = MATURITY_LABELS[entry.data.maturity] ?? entry.data.maturity;
const description = `${entry.data.title}（elements・${maturityLabel}）`;
// カードごとの OG 画像。実体は src/pages/og/[slug].png.ts がビルド時に生成する
const ogImage = `/og/${entry.id}.png`;
// 本文にも同じ絵を出す。画像下部のタイトルと署名はこのページの h1・出典と重複するため、
// aspect-ratio で刈って図の部分だけを見せる。
//
// 切る位置 y=400 は、生成済み 31 枚を走査した実測値。図の下端の最大は y=391
// （pretender-return-repetition。PAIR.row2=372 に maxSize=92 の字形の下出が乗る）、
// タイトルの上端の最小は y=410（2 行に折り返したとき）。共通の空白帯 392〜409 の中央を取った。
// 理論値では「し」の払いのようにベースラインより下へ出る分を落とすので、必ず実測すること。
// 3 つ目の図の形（single / pair 以外）を足したときは、この 400 を測り直す。
//
// figure を持たないカードは fallback（タイトルだけの絵）になるため本文には出さない。
const hasFigure = entry.data.figure !== undefined;
---

<BaseLayout
  title={`${entry.data.title} | elements`}
  description={description}
  ogImage={ogImage}
  ogImageSize={{ width: 1200, height: 630 }}
>
  <p class="mb-2 text-sm text-gray-500">
    <a href="/" class="hover:underline">lyricstheory.com</a> /
    <a href="/elements/" class="hover:underline">elements</a>
  </p>

  <article class="prose">
    <h1 class="mb-2 text-2xl font-bold">{entry.data.title}</h1>
    <div class="mb-6 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full border border-gray-400 px-2 py-0.5 text-gray-600">{entry.data.type}</span>
      <span class="rounded-full border border-gray-400 px-2 py-0.5 text-gray-600">{maturityLabel}</span>
      <span class="text-gray-500">最終更新: {entry.data.updated.toISOString().slice(0, 10)}</span>
    </div>

    {hasFigure && (
      <figure class="mb-8 aspect-[1200/400] overflow-hidden rounded-lg border border-gray-200">
        <img
          src={ogImage}
          alt={`図: ${entry.data.title}`}
          width="1200"
          height="630"
          class="block h-auto w-full"
        />
      </figure>
    )}

    <div class="post-body">
      <Content components={{ LyricQuote, Score }} />
    </div>

    <aside class="mt-12 border-t pt-6 text-sm">
      <dl class="space-y-4">
        {(phoneme.length > 0 || repetition || artist.length > 0 || era || lang) && (
          <div>
            <dt class="font-semibold text-gray-700">タグ</dt>
            <dd class="mt-1 text-gray-600">
              {repetition && <p>反復の類型: {REPETITION_LABELS[repetition]}</p>}
              {phoneme.length > 0 && <p>音素: {phoneme.join(', ')}</p>}
              {artist.length > 0 && <p>artist: {artist.join(', ')}</p>}
              {era && <p>年代: {era}</p>}
              <p>言語: {lang}</p>
            </dd>
          </div>
        )}
        {sources.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700">出典</dt>
            <dd class="mt-1 text-gray-600">
              <ul class="list-disc space-y-1 pl-5">
                {sources.map((source) => (
                  <li>
                    {splitLinks(source).map((segment) =>
                      segment.type === 'link' ? (
                        <a
                          href={segment.value}
                          class="break-all text-blue-700 underline"
                          target="_blank"
                          rel="noopener noreferrer">{segment.value}</a>
                      ) : (
                        segment.value
                      ),
                    )}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}
        {relatedLinks.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700">関連</dt>
            <dd class="mt-1">
              <ul class="list-disc space-y-1 pl-5">
                {relatedLinks.map((link) => (
                  <li>
                    <a href={link.href} class="text-blue-700 underline">
                      {link.title}
                    </a>
                    <span class="ml-1 text-xs text-gray-400">
                      {link.kind === 'essay' ? '(essay)' : '(element)'}
                    </span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}
      </dl>
    </aside>
  </article>
</BaseLayout>
