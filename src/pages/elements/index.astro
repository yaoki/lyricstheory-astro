---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const MATURITY_LABELS: Record<string, string> = {
  seed: '種 (seed)',
  budding: '芽 (budding)',
  evergreen: '常緑 (evergreen)',
};

const MATURITY_NOTES: Record<string, string> = {
  seed: '観察メモ。断片のままでよい',
  budding: '他のカードとの関連が張られた状態',
  evergreen: '定義・事例・反例が揃い、essay から参照できる状態',
};

const MATURITY_ORDER = ['seed', 'budding', 'evergreen'] as const;

// frontmatter に description が無いため、本文冒頭から簡易的に切り出す。
// import/export 行・見出し記号・MDX タグ・ルビ記法を除去した上で先頭 100 文字を目安に取る。
function excerpt(body: string | undefined, length = 100): string {
  if (!body) return '';
  const cleaned = body
    .split('\n')
    .filter((line) => !/^\s*(import|export)\s/.test(line))
    .join('\n')
    .replace(/<[^>]+>/g, '')
    .replace(/\[([^\]|]+)\|[^\]]+\]/g, '$1')
    .replace(/^#+\s*/gm, '')
    .replace(/[*_`>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.length > length ? `${cleaned.slice(0, length)}…` : cleaned;
}

const iso = (d: Date) => d.toISOString().slice(0, 10);

const entries = await getCollection('elements');
const sorted = [...entries].sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

// ---- 曲別グルーピング --------------------------------------------------------
// 93 枚が更新日だけで一列に並んでいると、同じ曲のカードが日付をまたいで散らばり、
// 「この曲について何が分かっているか」を辿れない。曲で束ねて回遊できるようにする。
//
// **新しい URL は切らない**（`/elements/artist/<slug>/` のようなファセットを作らない）。
// 切った瞬間に artist slug が SEO 資産になり、2026-07-25 の `shiina-ringo → sheena-ringo`
// のような一括改名が 301 なしにできなくなる（当時は URL に出ていなかったので無償だった）。
// グルーピングはこのページの中の見出しに留める。
type Group = { key: string; heading: string; items: typeof sorted };

// song を持たないカード（type: term / principle）を先頭に固定する。
// 用語カードは楽曲カード同士をつなぐハブなので、曲の下に埋めると入口にならない
const theoryCards = sorted.filter((entry) => !entry.data.song);

const songGroups = new Map<string, Group>();
for (const entry of sorted) {
  const song = entry.data.song;
  if (!song) continue;
  // 同名異曲を分けるため、キーはアーティストを含める
  const key = `${song.artist}／${song.title}`;
  const group = songGroups.get(key) ?? {
    key,
    heading: `${song.artist}『${song.title}』`,
    items: [],
  };
  group.items.push(entry);
  songGroups.set(key, group);
}

// `sorted` が更新順の降順なので、Map の挿入順がそのまま「グループの最新更新が新しい順」になる
const groups: Group[] = [
  ...(theoryCards.length > 0
    ? [{ key: '用語と方針', heading: '用語と方針（曲を対象としないカード）', items: theoryCards }]
    : []),
  ...songGroups.values(),
];

// 見出しとカードを 1 本の <ul> に並べる。見出しも <li> にしてあるのは、平坦表示
// （更新順・投稿順）へ切り替えるときに見出しだけ隠せば済むからで、リストを組み替えずに
// 済ませるため。復元用の順番は data-order が持つ
type Row =
  | { kind: 'header'; group: Group }
  | { kind: 'card'; group: Group; entry: (typeof sorted)[number] };

const rows: Row[] = groups.flatMap((group) => [
  { kind: 'header' as const, group },
  ...group.items.map((entry) => ({ kind: 'card' as const, group, entry })),
]);

const counts = MATURITY_ORDER.map((maturity) => ({
  maturity,
  label: MATURITY_LABELS[maturity],
  note: MATURITY_NOTES[maturity],
  count: sorted.filter((entry) => entry.data.maturity === maturity).length,
}));

// ---- 活動グリッド ----------------------------------------------------------
// frontmatter の created / updated から日ごとの活動を数える。
// updated は「最後の更新日」しか保持していないため、途中の更新は数えられない。
// 表示上もその旨を注記する。
const DAY = 86_400_000;
const WEEKS = 26;

type Activity = { created: number; updated: number };
const activity = new Map<string, Activity>();
const bump = (key: string, kind: keyof Activity) => {
  const rec = activity.get(key) ?? { created: 0, updated: 0 };
  rec[kind] += 1;
  activity.set(key, rec);
};

for (const entry of entries) {
  const c = iso(entry.data.created);
  const u = iso(entry.data.updated);
  bump(c, 'created');
  if (u !== c) bump(u, 'updated');
}

const now = new Date();
const todayUTC = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
const endSaturday = todayUTC + (6 - new Date(todayUTC).getUTCDay()) * DAY;
const startSunday = endSaturday - (WEEKS * 7 - 1) * DAY;

const weeks = Array.from({ length: WEEKS }, (_, w) => {
  const days = Array.from({ length: 7 }, (_, d) => {
    const ts = startSunday + (w * 7 + d) * DAY;
    const date = new Date(ts);
    const key = iso(date);
    const rec = activity.get(key) ?? { created: 0, updated: 0 };
    const total = rec.created + rec.updated;
    return { key, total, ...rec, future: ts > todayUTC, month: date.getUTCMonth() };
  });
  return { days, firstOfMonth: days[0].month };
});

// 月が変わる列にだけラベルを出す
const monthLabels = weeks.map((week, i) => {
  if (i === 0) return null;
  return week.firstOfMonth !== weeks[i - 1].firstOfMonth ? `${week.firstOfMonth + 1}月` : null;
});

const LEVELS = [
  'bg-gray-200',
  'bg-emerald-200',
  'bg-emerald-400',
  'bg-emerald-600',
  'bg-emerald-800',
];
const levelOf = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n <= 4 ? 3 : 4);

const activeDays = weeks.flatMap((w) => w.days).filter((d) => d.total > 0).length;
const rangeLabel = `${iso(new Date(startSunday))} 〜 ${iso(new Date(todayUTC))}`;
---

<BaseLayout
  title="elements | lyricstheory.com"
  description="音韻分析の要素カード一覧。子音ピボット・反復パターンなど、分析の最小単位。essays に結晶化する前の断片・観察・仮説を置く。"
>
  <p class="mb-2 text-sm text-gray-500">
    <a href="/" class="hover:underline">lyricstheory.com</a> / elements
  </p>
  <h1 class="mb-4 text-2xl font-bold">elements</h1>
  <p class="mb-4 text-gray-700">
    分析の最小単位。essays に結晶化する前の断片・観察・仮説を置く場所。書き上げて終わりにせず、公開したあとも手を入れ続けます。
  </p>

  <p class="mb-8 text-sm">
    <a href="/elements/sounds/" class="text-blue-700 underline">音で引く</a>
    <span class="text-gray-500"> — 語を入れると、その音について書かれた観察が返ります。</span>
  </p>

  <section class="mb-10 rounded border border-gray-200 p-4">
    <h2 class="mb-1 text-sm font-semibold text-gray-700">活動</h2>
    <p class="mb-3 text-xs text-gray-500">
      カード {sorted.length} 枚。直近 {WEEKS} 週（{rangeLabel}）のうち {activeDays} 日に、新規または更新があります。
    </p>

    <div class="overflow-x-auto pb-1">
      <div class="inline-block">
        <div
          class="mb-1 grid grid-flow-col text-[10px] leading-none text-gray-400"
          style="grid-auto-columns: 12px;"
        >
          {monthLabels.map((label) => <div class="overflow-visible whitespace-nowrap">{label}</div>)}
        </div>
        <div
          class="grid grid-flow-col gap-[2px]"
          style="grid-auto-columns: 10px; grid-template-rows: repeat(7, 10px);"
        >
          {
            weeks.flatMap((week) =>
              week.days.map((day) => (
                <div
                  class={`h-[10px] w-[10px] rounded-[2px] ${day.future ? 'bg-transparent' : LEVELS[levelOf(day.total)]}`}
                  title={
                    day.future
                      ? ''
                      : `${day.key}　新規 ${day.created} 件 / 更新 ${day.updated} 件`
                  }
                />
              )),
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-2 flex items-center gap-1 text-[10px] text-gray-400">
      <span class="mr-1">少</span>
      {LEVELS.map((cls) => <span class={`h-[10px] w-[10px] rounded-[2px] ${cls}`} />)}
      <span class="ml-1">多</span>
    </div>
    <p class="mt-2 text-[10px] text-gray-400">
      各カードが持つのは作成日と「最後の」更新日だけなので、途中の更新はここに現れません。実際の手入れはこれより多くなります。
    </p>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 text-sm font-semibold text-gray-700">成熟度</h2>
    <dl class="mb-3 space-y-1 text-xs text-gray-600">
      {
        counts.map(({ label, note }) => (
          <div class="flex gap-2">
            <dt class="shrink-0 font-medium">{label}</dt>
            <dd class="text-gray-500">— {note}</dd>
          </div>
        ))
      }
    </dl>
    <div class="flex flex-wrap gap-2 text-xs">
      <button
        type="button"
        data-filter-key="all"
        data-filter-value="all"
        aria-pressed="true"
        class="rounded-full border border-gray-400 px-3 py-1 text-gray-700 aria-pressed:border-gray-800 aria-pressed:bg-gray-800 aria-pressed:text-white"
      >
        すべて ({sorted.length})
      </button>
      {
        counts.map(({ maturity, label, count }) => (
          <button
            type="button"
            data-filter-key="maturity"
            data-filter-value={maturity}
            aria-pressed="false"
            disabled={count === 0}
            class="rounded-full border border-gray-400 px-3 py-1 text-gray-700 disabled:opacity-40 aria-pressed:border-gray-800 aria-pressed:bg-gray-800 aria-pressed:text-white"
          >
            {label} ({count})
          </button>
        ))
      }
    </div>
    <p class="mt-2 text-[11px] text-gray-400">
      カードに付いているバッジ（type・反復の類型・成熟度）を押しても、同じように絞り込めます。
    </p>
  </section>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b pb-2 text-xs">
    <p class="text-gray-500" data-visible-count>{sorted.length} 枚を表示中</p>
    <div class="flex gap-2">
      <button
        type="button"
        data-sort="group"
        aria-pressed="true"
        class="rounded border border-gray-300 px-2 py-1 text-gray-600 aria-pressed:border-gray-700 aria-pressed:text-gray-900"
      >
        曲別
      </button>
      <button
        type="button"
        data-sort="updated"
        aria-pressed="false"
        class="rounded border border-gray-300 px-2 py-1 text-gray-600 aria-pressed:border-gray-700 aria-pressed:text-gray-900"
      >
        更新順
      </button>
      <button
        type="button"
        data-sort="created"
        aria-pressed="false"
        class="rounded border border-gray-300 px-2 py-1 text-gray-600 aria-pressed:border-gray-700 aria-pressed:text-gray-900"
      >
        投稿順
      </button>
    </div>
  </div>

  <ul class="space-y-6" id="card-list">
    {
      rows.map((row, order) => {
        if (row.kind === 'header') {
          return (
            <li data-group-header data-group={row.group.key} data-order={order} class="!mt-10 first:!mt-0">
              <h2 class="border-b border-gray-300 pb-1 text-sm font-semibold text-gray-700">
                {row.group.heading}
                <span class="ml-2 font-normal text-gray-400" data-group-count>
                  {row.group.items.length}枚
                </span>
              </h2>
            </li>
          );
        }
        const { entry } = row;
        const phoneme = entry.data.tags?.phoneme ?? [];
        const artist = entry.data.tags?.artist ?? [];
        const tagLine = [
          phoneme.length > 0 ? `音素: ${phoneme.join(', ')}` : null,
          artist.length > 0 ? `artist: ${artist.join(', ')}` : null,
        ]
          .filter(Boolean)
          .join(' / ');
        return (
          <li
            data-maturity={entry.data.maturity}
            data-type={entry.data.type}
            data-repetition={entry.data.tags?.repetition}
            data-group={row.group.key}
            data-order={order}
            data-updated={iso(entry.data.updated)}
            data-created={iso(entry.data.created)}
          >
            <a href={`/elements/${entry.id}/`} class="text-lg font-medium text-blue-700 underline">
              {entry.data.title}
            </a>
            {/*
              バッジは絞り込みのボタンでもある。**新しい URL は作らない**（D6）——
              押すとこのページの中で絞り込まれるだけで、遷移はしない
            */}
            <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
              <button
                type="button"
                data-filter-key="type"
                data-filter-value={entry.data.type}
                class="rounded-full border border-gray-400 px-2 py-0.5 text-gray-600 hover:border-gray-700 hover:text-gray-900"
              >
                {entry.data.type}
              </button>
              {entry.data.tags?.repetition && (
                <button
                  type="button"
                  data-filter-key="repetition"
                  data-filter-value={entry.data.tags.repetition}
                  class="rounded-full border border-gray-400 px-2 py-0.5 text-gray-600 hover:border-gray-700 hover:text-gray-900"
                >
                  {entry.data.tags.repetition.toUpperCase()}反復
                </button>
              )}
              <button
                type="button"
                data-filter-key="maturity"
                data-filter-value={entry.data.maturity}
                class="rounded-full border border-gray-400 px-2 py-0.5 text-gray-600 hover:border-gray-700 hover:text-gray-900"
              >
                {MATURITY_LABELS[entry.data.maturity]}
              </button>
              <span class="text-gray-500">更新: {iso(entry.data.updated)}</span>
              <span class="text-gray-400">投稿: {iso(entry.data.created)}</span>
            </div>
            {tagLine && <p class="mt-1 text-xs text-gray-500">{tagLine}</p>}
            <p class="mt-2 text-sm text-gray-600">{excerpt(entry.body)}</p>
          </li>
        );
      })
    }
  </ul>

  {sorted.length === 0 && <p class="text-gray-500">まだ種がありません。</p>}

  <section class="mt-16 border-t pt-6 text-sm text-gray-600">
    <p>
      この庭の仕組み — カードの構造、分類の規約、理論用語集 — は GitHub で公開しています。同じやり方で自分の庭を作りたい方は、そのまま真似してください。
    </p>
    <p class="mt-2">
      <a
        href="https://github.com/yaoki/lyricstheory-astro"
        rel="noopener noreferrer"
        class="text-blue-700 underline">yaoki/lyricstheory-astro</a
      >
    </p>
  </section>
</BaseLayout>

<script>
  const list = document.getElementById('card-list');
  if (list) {
    const rows = () => Array.from(list.children) as HTMLLIElement[];
    const isHeader = (li: HTMLLIElement) => li.dataset.groupHeader !== undefined;
    const countLabel = document.querySelector('[data-visible-count]');

    // 絞り込みは「キーと値の 1 組」で持つ。maturity 専用だった頃の実装を一般化したもので、
    // type・反復の類型・成熟度がすべて同じ道を通る。**軸を増やしても URL は増えない**
    let filterKey = 'all';
    let filterValue = 'all';
    let sortKey = 'group';

    const sortButtons = document.querySelectorAll('[data-sort]');
    // カード内のバッジも同じ属性を持つが、押下状態を表示するのは上部のボタンだけ。
    // 同じ値のバッジが何十個も並ぶため、全部を光らせても現在地は伝わらない
    const filterButtons = Array.from(document.querySelectorAll('[data-filter-key]')).filter(
      (btn) => !btn.closest('#card-list'),
    );

    const render = () => {
      let visible = 0;
      const cards = rows().filter((li) => !isHeader(li));
      cards.forEach((li) => {
        const show = filterKey === 'all' || li.dataset[filterKey] === filterValue;
        li.hidden = !show;
        if (show) visible += 1;
      });

      // 見出しは曲別のときだけ出す。絞り込みで中身が空になったグループは隠し、
      // 残ったグループの枚数は**いま見えている枚数**に合わせる。総数のまま置くと、
      // 「15枚」と書かれた見出しの下に3枚しか無い状態になり、数が嘘になる
      rows()
        .filter(isHeader)
        .forEach((header) => {
          if (sortKey !== 'group') {
            header.hidden = true;
            return;
          }
          const inGroup = cards.filter((li) => li.dataset.group === header.dataset.group && !li.hidden);
          const counter = header.querySelector('[data-group-count]');
          if (counter) counter.textContent = `${inGroup.length}枚`;
          header.hidden = inGroup.length === 0;
        });

      if (countLabel) {
        countLabel.textContent =
          filterKey === 'all'
            ? `${visible} 枚を表示中`
            : `${visible} 枚を表示中（${filterKey}: ${filterValue}）`;
      }

      filterButtons.forEach((btn) => {
        const el = btn as HTMLElement;
        btn.setAttribute(
          'aria-pressed',
          String(el.dataset.filterKey === filterKey && el.dataset.filterValue === filterValue),
        );
      });
      sortButtons.forEach((btn) => {
        btn.setAttribute('aria-pressed', String((btn as HTMLElement).dataset.sort === sortKey));
      });
    };

    const byOrder = (a: HTMLLIElement, b: HTMLLIElement) =>
      Number(a.dataset.order ?? 0) - Number(b.dataset.order ?? 0);

    const reorder = () => {
      rows()
        .sort((a, b) => {
          // 曲別は元の並びそのもの。data-order で完全に復元する（見出しも一緒に戻る）
          if (sortKey === 'group') return byOrder(a, b);
          // 平坦表示でだけ見出しを末尾へ退ける。hidden にするだけだと、カードの並べ替えの
          // 比較対象に混ざって順序が不安定になる
          const ah = isHeader(a);
          const bh = isHeader(b);
          if (ah !== bh) return ah ? 1 : -1;
          if (ah && bh) return byOrder(a, b);
          return (b.dataset[sortKey] ?? '').localeCompare(a.dataset[sortKey] ?? '');
        })
        .forEach((li) => list.appendChild(li));
    };

    document.querySelectorAll('[data-filter-key]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        filterKey = el.dataset.filterKey ?? 'all';
        filterValue = el.dataset.filterValue ?? 'all';
        render();
      });
    });

    sortButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortKey = (btn as HTMLElement).dataset.sort ?? 'group';
        reorder();
        render();
      });
    });

    // `/elements/#budding` のような従来のアンカーは maturity の絞り込みとして解釈する
    // （既存のリンクを壊さない）。`#type=pivot` のようにキーを明示した形も受ける
    const hash = decodeURIComponent(location.hash.replace('#', ''));
    if (hash) {
      const [key, value] = hash.includes('=') ? hash.split('=') : ['maturity', hash];
      if (rows().some((li) => li.dataset[key] === value)) {
        filterKey = key;
        filterValue = value;
      }
    }
    render();
  }
</script>
