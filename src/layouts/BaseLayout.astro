---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface ArticleMeta {
  headline: string;
  description: string;
  datePublished: string; // ISO 8601
  dateModified?: string;
  image?: string; // 絶対URLまたは/wordpress/...
  url: string; // 記事の絶対URL
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** ogImage の実寸。渡すと og:image:width / height を出力する */
  ogImageSize?: { width: number; height: number };
  article?: ArticleMeta;
}

const { title, description, ogImage, ogImageSize, article } = Astro.props as Props;

const siteUrl = 'https://lyricstheory.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const image = ogImage || `${siteUrl}/favicon.svg`;

const authorName = 'やおき (the 8 rise)';
const siteName = 'lyricstheory.com';

// 著者の同一性の正本は src/content/author/yaoki.md。ここに写しを置かない。
// sameAs が無いと、AI や検索エンジンは著者が誰かを外部と照合できない。
const authorEntry = await getEntry('author', 'yaoki');
const authorUrl = authorEntry?.data.url ?? `${siteUrl}/author/yaoki/`;
const authorSameAs = authorEntry?.data.sameAs ?? [];
const authorAlternateName = authorEntry?.data.alternateName ?? [];

const articleJsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article.headline,
      description: article.description,
      datePublished: article.datePublished,
      ...(article.dateModified ? { dateModified: article.dateModified } : {}),
      author: {
        '@type': 'Person',
        name: authorEntry?.data.name ?? authorName,
        ...(authorAlternateName.length > 0 ? { alternateName: authorAlternateName } : {}),
        url: authorUrl,
        ...(authorSameAs.length > 0 ? { sameAs: authorSameAs } : {}),
      },
      license: 'https://creativecommons.org/licenses/by/4.0/',
      publisher: {
        '@type': 'Organization',
        name: siteName,
        url: siteUrl,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': article.url,
      },
      ...(article.image ? { image: absoluteUrl(article.image) } : {}),
      inLanguage: 'ja',
    }
  : null;

function absoluteUrl(pathOrUrl: string): string {
  if (/^https?:\/\//.test(pathOrUrl)) return pathOrUrl;
  return `${siteUrl}${pathOrUrl.startsWith('/') ? pathOrUrl : `/${pathOrUrl}`}`;
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="lyricstheory.com" href="/feed/index.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={absoluteUrl(image)} />
    {ogImageSize && (
      <Fragment>
        <meta property="og:image:width" content={String(ogImageSize.width)} />
        <meta property="og:image:height" content={String(ogImageSize.height)} />
      </Fragment>
    )}
    {article?.datePublished && (
      <meta property="article:published_time" content={article.datePublished} />
    )}
    {article?.dateModified && (
      <meta property="article:modified_time" content={article.dateModified} />
    )}
    {article && <meta property="article:author" content={authorName} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={absoluteUrl(image)} />

    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}

    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />

    <slot name="head" />
  </head>
  <body class="mx-auto max-w-3xl px-4 py-8 leading-relaxed">
    <header class="mb-8 flex items-baseline justify-between gap-4 border-b pb-4">
      <a href="/" class="text-lg font-bold">{siteName}</a>
      <nav class="flex gap-4 text-sm">
        <a href="/elements/" class="text-gray-600 hover:underline">elements</a>
        <a href="/books/" class="text-gray-600 hover:underline">推薦図書</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t pt-4 text-sm text-gray-500">
      <p class="mb-1">
        <a href="/author/yaoki/" class="hover:underline">{authorName}</a> · {siteName}
      </p>
      <p>
        記事本文・図・理論の記述は <a
          href="https://creativecommons.org/licenses/by/4.0/deed.ja"
          rel="license"
          class="underline">CC BY 4.0</a
        >。引用・翻案・AI 学習を歓迎します（<a href="/license/" class="underline">条件</a
        >）。歌詞の引用部分は原著作者に権利があります。
      </p>
    </footer>
  </body>
</html>
